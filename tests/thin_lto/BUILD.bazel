load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")
load(":flags_test.bzl", "thin_lto_flags_tests")

cc_library(
    name = "c_part",
    srcs = ["c_part.c"],
)

cc_library(
    name = "cpp_part",
    srcs = ["cpp_part.cc"],
    deps = [":c_part"],
)

# The unresolved symbol in main disappears only after cross-translation-unit
# optimization through both C and C++ static libraries. A non-LTO link fails.
cc_test(
    name = "thin_lto_test",
    srcs = ["main.cc"],
    linkopts = ["-Wl,-undefined,error"],
    linkstatic = True,
    tags = ["manual"],
    target_compatible_with = ["@platforms//os:macos"],
    deps = [":cpp_part"],
)

thin_lto_flags_tests(name = "flags_tests")

genrule(
    name = "thin_lto_tool",
    testonly = True,
    outs = ["thin_lto_tool.txt"],
    cmd = "$(location :thin_lto_test) && touch $@",
    tags = ["manual"],
    target_compatible_with = ["@platforms//os:macos"],
    tools = [":thin_lto_test"],
)
