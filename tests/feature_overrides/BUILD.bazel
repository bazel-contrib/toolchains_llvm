load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_test")

exports_files(["override_input.rsp"])

cc_test(
    name = "selection_test",
    size = "small",
    srcs = ["selection_test.cc"],
)

# Rule-local features are not build-configuration predicates.
cc_test(
    name = "per_rule_features_test",
    size = "small",
    srcs = ["selection_test.cc"],
    features = [
        "test_override",
        "test_second",
    ],
)

cc_binary(
    name = "selection_tool",
    srcs = ["selection_test.cc"],
)

genrule(
    name = "exec_selection",
    outs = ["exec_selection.txt"],
    cmd = "$(location :selection_tool) && touch $@",
    tools = [":selection_tool"],
)
