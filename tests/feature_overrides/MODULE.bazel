module(name = "feature_override_tests")

bazel_dep(name = "toolchains_llvm", version = "0.0.0")
local_path_override(module_name = "toolchains_llvm", path = "../..")
bazel_dep(name = "rules_cc", version = "0.2.25")

llvm = use_extension("@toolchains_llvm//toolchain/extensions:llvm.bzl", "llvm")
llvm.toolchain(
    name = "llvm_toolchain",
    llvm_version = "23.1.2",
    linker = {"darwin-aarch64": "auto", "darwin-x86_64": "auto", "linux-x86_64": "mold"},
    linker_version = "2.40.4",
    cxx_standard = {"": "c++17"},
    extra_compile_flags = {"": ["-DBASE_TOOLCHAIN=1"]},
)
llvm.feature_override(
    name = "llvm_toolchain",
    features = ["test_override", "test_second", "-test_disable", "-test_distribution", "-thin_lto"],
    targets = ["darwin-aarch64", "darwin-x86_64", "linux-x86_64"],
    cxx_standard = {"": "c++20"},
    extra_compile_flags = {"": ["-DFEATURE_TOOLCHAIN=1", "@override_input.rsp"]},
    extra_compiler_files = "//:override_input.rsp",
)
llvm.feature_override(
    name = "llvm_toolchain",
    features = ["test_distribution", "-test_override", "-thin_lto"],
    llvm_version = "22.1.8",
    reset = ["extra_compile_flags"],
)
llvm.feature_override(
    name = "llvm_toolchain",
    features = ["thin_lto", "-test_override", "-test_distribution"],
    linker = {"linux-x86_64": ""},
)
use_repo(llvm, "llvm_toolchain")
register_toolchains("@llvm_toolchain//:all")
