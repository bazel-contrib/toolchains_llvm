load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")

# Keep module_interfaces in a separate package: Bazel 7 rejects the attribute
# while loading a package, even when the target is tagged manual and unbuilt.
cc_library(
    name = "cpp20_module",
    module_interfaces = ["cpp20_module.cppm"],
)

cc_test(
    name = "cpp20_module_test",
    size = "small",
    srcs = ["cpp20_module_test.cc"],
    deps = [":cpp20_module"],
)
