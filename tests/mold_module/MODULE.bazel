module(name = "toolchains_llvm_mold_test")

bazel_dep(name = "mold", version = "2.40.4")
bazel_dep(name = "rules_cc", version = "0.2.26")
bazel_dep(name = "toolchains_llvm", version = "0.0.0")

local_path_override(
    module_name = "toolchains_llvm",
    path = "../..",
)

# Temporary until mboworks_bzl 0.6.0 is available in the Bazel Central Registry:
# https://github.com/bazelbuild/bazel-central-registry/pull/11157
archive_override(
    module_name = "mboworks_bzl",
    integrity = "sha256-fUkSqNu6DQIV93cBiWbHOApqhV8UQhxlDLrKIRa1YEQ=",
    strip_prefix = "bzl-0.6.0",
    urls = ["https://github.com/mboworks/bzl/releases/download/0.6.0/bzl-0.6.0.tar.gz"],
)

llvm = use_extension("@toolchains_llvm//toolchain/extensions:llvm.bzl", "llvm")
inject_repo(llvm, "mold")
llvm.toolchain(
    name = "llvm_toolchain_mold",
    exec_arch = "x86_64",
    exec_os = "linux",
    linker = {"linux-x86_64": "mold"},
    llvm_version = "19.1.7",
)
use_repo(llvm, "llvm_toolchain_mold")
