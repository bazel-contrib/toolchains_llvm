module(name = "toolchains_llvm_mold_test")

bazel_dep(name = "mold", version = "2.40.4")
bazel_dep(name = "rules_cc", version = "0.2.26")
bazel_dep(name = "toolchains_llvm", version = "0.0.0")

local_path_override(
    module_name = "toolchains_llvm",
    path = "../..",
)

llvm = use_extension("@toolchains_llvm//toolchain/extensions:llvm.bzl", "llvm")
inject_repo(llvm, "mold")
llvm.toolchain(
    name = "llvm_toolchain_mold",
    exec_arch = "x86_64",
    exec_os = "linux",
    linker = {"linux-x86_64": "mold"},
    llvm_version = "19.1.7",
)
use_repo(llvm, "llvm_toolchain_mold")

# Pin the merged collection API from mboworks/bzl#75 until its next release.
archive_override(
    module_name = "mboworks_bzl",
    integrity = "sha256-i1EsPbRBlMEmvOibBfQoJ5laUhSpdF1LvicLG+0BwCo=",
    strip_prefix = "bzl-9c6560ccd828c84fe28f667fb89a29f197161251",
    urls = ["https://github.com/mboworks/bzl/archive/9c6560ccd828c84fe28f667fb89a29f197161251.tar.gz"],
)
