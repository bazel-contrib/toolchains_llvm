module(name = "toolchains_llvm_mold_test")

bazel_dep(name = "mold", version = "2.40.4")
bazel_dep(name = "rules_cc", version = "0.2.26")
bazel_dep(name = "toolchains_llvm", version = "0.0.0")

local_path_override(
    module_name = "toolchains_llvm",
    path = "../..",
)

llvm = use_extension("@toolchains_llvm//toolchain/extensions:llvm.bzl", "llvm")
inject_repo(llvm, "mold")
llvm.toolchain(
    name = "llvm_toolchain_mold",
    exec_arch = "x86_64",
    exec_os = "linux",
    linker = {"linux-x86_64": "mold"},
    llvm_version = "19.1.7",
)
use_repo(llvm, "llvm_toolchain_mold")

# Pin mboworks/bzl#78 normalization until 0.8.0 is published; then remove this override.
archive_override(
    module_name = "mboworks_bzl",
    integrity = "sha256-ARiUvKPNeXxnnsXAkrnvY8aBvjhkMnNC6SeiLKbqq9I=",
    strip_prefix = "bzl-f99bc54fe433259865d5c054ee4afed73e237302",
    urls = ["https://github.com/mboworks/bzl/archive/f99bc54fe433259865d5c054ee4afed73e237302.tar.gz"],
)
